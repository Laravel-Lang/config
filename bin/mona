#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dotenv\Dotenv;
use LaravelLang\Mona\Commands\Cldr\CldrCountry;
use LaravelLang\Mona\Commands\Cldr\CldrLocale;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

$dotenv = Dotenv::createImmutable(__DIR__ . '/../');
$dotenv->safeLoad();

$application = new Application('Laravel-Lang: Mona');

$application->addCommands([
    new CldrCountry,
    new CldrLocale,
]);

$application->run();
