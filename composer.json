{
    "name": "laravel-lang/config",
    "description": "The Laravel-Lang config package",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel-lang",
        "lang",
        "languages",
        "laravel",
        "locale",
        "locales",
        "localization",
        "localizations",
        "translation",
        "translations",
        "config",
        "settings"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro",
            "homepage": "https://dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-data": "^4.23"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Config\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelLang\\Config\\LaravelLangConfigServiceProvider"
            ]
        }
    }
}
