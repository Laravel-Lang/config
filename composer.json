{
    "name": "laravel-lang/config",
    "description": "The Laravel-Lang config package",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel-lang",
        "i18n",
        "locales",
        "localization",
        "translations",
        "config"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/container": "^12.0 || ^13.0 || dev-master",
        "illuminate/support": "^12.0 || ^13.0 || dev-master",
        "laravel-lang/locale-list": "self.version",
        "laravel-lang/locale-names": "self.version",
        "laravel-lang/locales": "self.version"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\Config\\": "src/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelLang\\Config\\LangConfigServiceProvider"
            ]
        }
    }
}
