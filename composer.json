{
    "name": "laravel-lang/mona",
    "description": "Easily connect the necessary language packs to the application",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://laravel-lang.com"
        }
    ],
    "homepage": "https://laravel-lang.com",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^4.0",
        "symfony/var-dumper": "^7.4"
    },
    "replace": {
        "laravel-lang/actions": "self.version",
        "laravel-lang/attributes": "self.version",
        "laravel-lang/common": "self.version",
        "laravel-lang/config": "self.version",
        "laravel-lang/http-statuses": "self.version",
        "laravel-lang/json-fallback": "self.version",
        "laravel-lang/lang": "self.version",
        "laravel-lang/library": "self.version",
        "laravel-lang/locale-list": "self.version",
        "laravel-lang/locales": "self.version",
        "laravel-lang/models": "self.version",
        "laravel-lang/moonshine": "self.version",
        "laravel-lang/native-country-names": "self.version",
        "laravel-lang/native-currency-names": "self.version",
        "laravel-lang/native-locale-names": "self.version",
        "laravel-lang/publisher": "self.version",
        "laravel-lang/routes": "self.version",
        "laravel-lang/starter-kits": "self.version",
        "laravel-lang/status-generator": "self.version"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LaravelLang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "17.x-dev"
        }
    }
}
